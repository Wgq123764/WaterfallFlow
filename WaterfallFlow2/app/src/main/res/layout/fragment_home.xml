<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部空白栏，用于后续添加小说、漫画等选项 -->
    <LinearLayout
        android:id="@+id/top_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="?android:attr/colorBackground"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <!-- 这里可以后续添加小说、漫画等选项卡 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#666666"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 布局切换控制面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        android:padding="16dp"
        android:elevation="4dp">

        <RadioGroup
            android:id="@+id/layout_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_single_column"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="单列"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/radio_double_column"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="双列"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/radio_three_column"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="三列" />

        </RadioGroup>

        <!-- 删除了应用布局按钮 -->

    </LinearLayout>

    <!-- 主页内容区域，使用SwipeRefreshLayout支持下拉刷新 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>